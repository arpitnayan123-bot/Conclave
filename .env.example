# ─── Conclave server environment ───────────────────────────────
# Copy to .env and fill in. The app refuses to sign tokens without AUTH_SECRET.

# HMAC secret for member/admin tokens — any long random string.
AUTH_SECRET=change-me-to-a-long-random-string

# Committee console password (unlocks #/admin).
ADMIN_PASSWORD=change-me

# SQLite database (created by `bun run db:push`).
DATABASE_URL="file:./db/custom.db"
